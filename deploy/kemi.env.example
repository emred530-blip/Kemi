# Kemi server settings — copy to /etc/kemi/kemi.env and edit.
# Every unit in deploy/systemd reads this file. Restart after changing it:
#   sudo systemctl restart kemi-node kemi-portal kemi-gateway

# The public address other nodes will use to reach this machine. Set it to the
# server's domain or public IP, or peers behind NAT will learn a private one.
KEMI_ADVERTISE=kemi.example.com

# The node's peer-to-peer port. Must be open in the firewall for BOTH tcp and
# udp — udp carries discovery, tcp carries the work.
KEMI_PORT=7700

# Peers this machine joins on start. Leave empty on your first server: it then
# becomes an entry point others join through. Repeat the flag for more peers.
KEMI_PEERS=

# Compute this machine sells. 'mock' answers instantly and is only good for a
# smoke test — a public portal wants a real backend.
#   ollama       + KEMI_AI_MODEL=llama3.2   (install ollama separately)
#   transformers + KEMI_AI_MODEL=Qwen/Qwen2.5-0.5B-Instruct
KEMI_AI_BACKEND=mock
KEMI_AI_MODEL=

# Credits charged per work item served to the network.
KEMI_PRICE=1.0

# Starting credits handed to each new visitor of the portal, funded from this
# machine's balance, and how many such allowances one address may claim per
# hour. Set the cap to 0 only on a private deployment.
KEMI_FAUCET=10
KEMI_GUESTS_PER_IP=5

# The operator console key. GENERATE YOUR OWN before the first start:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
KEMI_ADMIN_KEY=change-me-before-starting

# Loopback bind addresses. nginx is the only thing that should reach these
# directly; do not expose them without a reverse proxy in front.
KEMI_PORTAL_PORT=8090
KEMI_GATEWAY_PORT=11434
KEMI_DASHBOARD_PORT=8080
